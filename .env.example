# LighTrade 環境變數範本
# 複製為 .env 後填入；切勿 commit
API_KEY=
SECRET_KEY=
SIMULATION=true
CA_PATH=
CA_PASSWD=

# 可選：CORS 額外允許的 origin（逗號分隔）
LIGHTRADE_ALLOWED_ORIGINS=

# 可選：API Token。設定後所有 /api 與 WebSocket 都需要帶此 token
# （前端在設定視窗填同一組 token）。Docker / LAN 部署強烈建議設定。
LIGHTRADE_API_TOKEN=

# 可選：SIMULATION=false（真實帳戶）時，預設「不會」開機自動登入，
# 需明確設 true 才允許無人值守登入 LIVE 帳戶
LIGHTRADE_ALLOW_LIVE_AUTOLOGIN=
